"VertexlitGeneric"
{
//Base Parameter
	"$basetexture" "models/tz/puppet/jaw"
	"$bumpmap" "models/tz/puppet/jaw_n"
	//"$color2" "[.9 .9 .9]"

//Phong Parameter
	"$Phong"	 "1"
	"$phongexponent" "5"
	"$PhongBoost" ".1"

	"$PhongFresnelRanges" "[1 1 1]" //Controlls the optional Fresnel term

	"$phongexponenttexture" "models/tz/puppet/jaw_s" //Specular debe ser negativo al de Blender

	"$phongexponentfactor" "0.25"

	"$PhongAlbedoTint" "1"
	"$PhongTint" "[.8 .15 .15]"
	"$phongalbedoboost" "3"
	"$NormalmapAlphaPhongMask"  "1"

//Rimlight Parameter
	"$Rimlight" "1"
	"$RimMask" "1"
	"$RimlightExponent" "2"
	"$RimlightBoost" "1.0"

//Other
	"$Model" "1"
	"$HalfLambert" "1"
	"$AmbientOcclusion" "1"
	"$NoCull" "0" //Disables backface culling
	"$SurfaceProp" "flesh"
}
